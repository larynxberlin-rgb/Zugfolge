[Unit]
Description=Zugfolge Alpha (explicit attested map rollback mode)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Conflicts=zugfolge-alpha.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zugfolge
ExecStart=/usr/bin/env bash /opt/zugfolge/tools/alpha-ops/compose-with-map-release-env.sh --attested-rollback -f /opt/zugfolge/compose.yml up --no-build --force-recreate --wait --wait-timeout 600
ExecStop=/usr/bin/env bash /opt/zugfolge/tools/alpha-ops/compose-with-map-release-env.sh --fixed-stop -f /opt/zugfolge/compose.yml down
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
