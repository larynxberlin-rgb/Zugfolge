{
  "name": "zugfolge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zugfolge — persistente Eisenbahn-Unternehmenssimulation. Monorepo-Wurzel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larynxberlin-rgb/Zugfolge.git"
  },
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --stream build",
    "typecheck": "pnpm -r --stream typecheck",
    "test": "pnpm -r --stream test",
    "guards": "pnpm --filter @zugfolge/guards run guards",
    "licenses": "pnpm --filter @zugfolge/guards run licenses",
    "alpha:build": "bash tools/alpha-ops/build-alpha-images.sh",
    "alpha:up": "bash tools/alpha-ops/phase1-smoke.sh",
    "alpha:phase3": "bash tools/alpha-ops/phase3-acceptance.sh",
    "alpha:down": "bash tools/alpha-ops/compose-with-map-release-env.sh -f compose.alpha.yml down"
  }
}
