# Kopieren nach .env und mit echten Werten füllen. .env selbst ist ignoriert.

DATABASE_URL=postgres://zugfolge:zugfolge@localhost:5432/zugfolge
KEYCLOAK_ISSUER=https://auth.zugfolge.example/realms/zugfolge
KEYCLOAK_AUDIENCE=game-api
# Starkes, nur zwischen Simulation und API geteiltes Bearer-Geheimnis.
LIVEMAP_INGEST_TOKEN=replace-with-at-least-32-random-characters
SIMULATION_INGEST_TOKEN=replace-with-a-different-32-character-secret
FLEET_INGEST_TOKEN=replace-with-a-third-32-character-secret
# JSON-Objekt je EVU-ID mit cashAccountId, revenueAccountId und costAccountIds.
ECONOMY_LEDGER_ACCOUNTS_JSON={}
# Optional — Standard ist <KEYCLOAK_ISSUER>/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URI=
PORT=3000
