# Kopieren nach .env und mit echten Werten füllen. .env selbst ist ignoriert.

DATABASE_URL=postgres://zugfolge:zugfolge@localhost:5432/zugfolge
KEYCLOAK_ISSUER=https://auth.zugfolge.example/realms/zugfolge
KEYCLOAK_AUDIENCE=game-api
# Starkes, nur zwischen Simulation und API geteiltes Bearer-Geheimnis.
SIMULATION_INGEST_TOKEN=replace-with-a-different-32-character-secret
FLEET_INGEST_TOKEN=replace-with-a-third-32-character-secret
# Absolute, lokal gebaute napi-rs-Addons; Produktion besitzt keinen JS-Fallback.
ZUGFOLGE_RUNTIME_NATIVE_PATH=/absolute/path/to/zugfolge_runtime_napi.node
ZUGFOLGE_PLANNING_RUNTIME_NATIVE_PATH=/absolute/path/to/zugfolge_planning_runtime_napi.node
# Absoluter Pfad zu einem unveraenderlichen zugfolge-fleet-authority-release-catalog/v1.
ZUGFOLGE_FLEET_AUTHORITY_RELEASE_PATH=/absolute/path/to/fleet-authority-releases.json
# Fail-closed M3: unveraenderliche Infrastruktur-Releases und Authority-Konto je Welt.
PLANNING_INFRASTRUCTURE_RELEASES_JSON=replace-with-validated-release-array
PLANNING_AUTHORITY_ACCOUNT_IDS_JSON={"world-uuid":"authority-account-uuid"}
# JSON-Objekt je EVU-ID mit cashAccountId, revenueAccountId und costAccountIds.
ECONOMY_LEDGER_ACCOUNTS_JSON={}
# Optional — Standard ist <KEYCLOAK_ISSUER>/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URI=
PORT=3000
