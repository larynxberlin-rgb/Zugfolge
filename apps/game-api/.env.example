# Kopieren nach .env und mit echten Werten füllen. .env selbst ist ignoriert.

DATABASE_URL=postgres://zugfolge:zugfolge@localhost:5432/zugfolge
KEYCLOAK_ISSUER=https://auth.zugfolge.example/realms/zugfolge
KEYCLOAK_AUDIENCE=game-api
# Optional — Standard ist <KEYCLOAK_ISSUER>/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URI=
PORT=3000
