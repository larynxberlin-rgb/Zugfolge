# Zugfolge Alpha — kopieren nach .env; niemals echte Geheimnisse committen.
POSTGRES_USER=zugfolge
POSTGRES_PASSWORD=replace-game-db-password
POSTGRES_DB=zugfolge
ODOO_DB_PASSWORD=replace-odoo-db-password
ODOO_DB_NAME=zugfolge_odoo
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=alpha-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-keycloak-bootstrap-password
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-provisioner-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=provisioner
KEYCLOAK_REALM=zugfolge
# Versionierte, manuell ausgefuehrte public->keycloak-Migration. Das normale
# Compose-Profil fuehrt niemals Schema-DDL aus und verlangt einen installierten
# Up-, Recover- oder Fresh-Bootstrap-Receipt.
KEYCLOAK_SCHEMA_EVIDENCE_HOST_DIR=./var/keycloak-schema-migration
KEYCLOAK_SCHEMA_BACKUP_HOST_DIR=./var/keycloak-schema-backup
KEYCLOAK_SCHEMA_RESTORE_DATABASE=zugfolge_restore_keycloak_schema
KEYCLOAK_SCHEMA_RESTORE_RECEIPT_CONTAINER_PATH=/keycloak-schema/restore-receipt.json
KEYCLOAK_SCHEMA_OPERATOR_UID=1000
KEYCLOAK_SCHEMA_OPERATOR_GID=1000
KEYCLOAK_SCHEMA_RECEIPT_CONTAINER_PATH=/keycloak-schema/receipt.json
KEYCLOAK_SCHEMA_BOOTSTRAP_ALLOWED=false
# Nur mit --profile keycloak-schema-migration verwenden. Vor Up/Down muessen
# alle Writer gestoppt und der Wert ausdruecklich auf true gesetzt werden.
KEYCLOAK_SCHEMA_ACTION=inspect
KEYCLOAK_SCHEMA_WRITERS_QUIESCED=false
KEYCLOAK_SCHEMA_BACKUP_BINDING_CONTAINER_PATH=/keycloak-schema/backup-binding.json
KEYCLOAK_SCHEMA_PLAN_CONTAINER_PATH=/keycloak-schema/plan.json
KEYCLOAK_SCHEMA_RECEIPT_OUTPUT_CONTAINER_PATH=/keycloak-schema/receipt.json
KEYCLOAK_SCHEMA_BOOTSTRAP_RECEIPT_OUTPUT_CONTAINER_PATH=/keycloak-schema/receipt.json
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/zugfolge
KEYCLOAK_AUDIENCE=game-api
KEYCLOAK_INVITATION_REDIRECT_URI=http://localhost:4173/
GAME_WEB_URL=http://localhost:4173
GAME_WEB_PUBLIC_URL=http://localhost:4173
LIVEMAP_PUBLIC_URL=http://localhost:4174
LIVEMAP_OIDC_CLIENT_ID=livemap
LIVEMAP_BASE_PATH=/
OPERATIONS_CENTER_BASE_PATH=/
OPERATIONS_CENTER_GAME_API_URL=/api
GAME_API_PUBLIC_URL=/api
ALPHA_PUBLIC_WORLD_ID=00000000-0000-4000-8000-000000000014
# Genau eine Spielwelt pro Server/Subdomain; muss ALPHA_PUBLIC_WORLD_ID entsprechen.
ZUGFOLGE_WORLD_ID=00000000-0000-4000-8000-000000000014
OPERATIONS_CENTER_URL=http://localhost:4175
OPERATIONS_CENTER_OIDC_CLIENT_ID=operations-center
GAME_API_PORT=3000
GAME_WEB_PORT=4173
LIVEMAP_PORT=4174
OPERATIONS_CENTER_PORT=4175
STATIC_PORT=4179
# Einzige statische Kartenquelle. ID, Releasepfad und URLs stehen ausschließlich
# in ${MAP_RELEASE_DEPLOYMENT_HOST_ROOT}/active/map-release.env.
MAP_RELEASE_DEPLOYMENT_HOST_ROOT=./var/maps
# Stellt evidence.json, restore-proof.json, database-rollback-proof.json und trusted-delivery-keys.json bereit.
MAP_RELEASE_PREFLIGHT_HOST_DIR=./var/map-release-preflight
# Tatsächlich auf einen vorbereiteten Leerpfad wiederhergestellter, vollständiger Buildcache.
MAP_RELEASE_RESTORE_HOST_DIR=./var/map-release-restore/infra-deutschland-2026.4
# Vollständige, signierte v3-Rollbackidentität. Die Platzhalter müssen exakt aus
# der Rollback-Attestation und ihren gebundenen Datei-Artefakten übernommen werden.
# Der aktuelle Stack und der alte Rückweg sind absichtlich zwei verschiedene
# unveränderliche Images. Zulässig sind jeweils eine lokale sha256:...-Image-ID
# oder eine kleingeschriebene repository/path@sha256:...-Referenz. Die Legacy-
# Referenz muss exakt auf den separat attestierten nackten Digest enden.
MAP_RELEASE_PREFLIGHT_DATABASE_ROLLBACK_PROOF_PATH=/map-preflight/database-rollback-proof.json
MAP_RELEASE_PREFLIGHT_RUNTIME_SOURCE_COMMIT=replace-with-attested-rollback-source-commit
ZUGFOLGE_GAME_API_IMAGE_REFERENCE=sha256:replace-with-current-game-api-image-id
ZUGFOLGE_ODOO_IMAGE_REFERENCE=sha256:replace-with-current-odoo-image-id
MAP_RELEASE_PREFLIGHT_RUNTIME_IMAGE_DIGEST=sha256:replace-with-attested-rollback-image-digest
MAP_RELEASE_PREFLIGHT_RUNTIME_IMAGE_REFERENCE=sha256:replace-with-attested-rollback-image-id
PRODUCTION_RECOVERY_ODOO_IMAGE_DIGEST=sha256:replace-with-attested-rollback-odoo-image-digest
PRODUCTION_RECOVERY_ODOO_IMAGE_REFERENCE=sha256:replace-with-attested-rollback-odoo-image-id
# Expliziter, vor dem V2-Cutover vollständig vorbereiteter und nach einem
# Rollback erneut qualifizierter V1-Rückweg. Die drei Hostwurzeln müssen
# bereits existieren, symlinkfrei und rootgeschützt sein; Compose legt sie
# absichtlich nicht als beliebige anonyme Verzeichnisse an.
PRODUCTION_RECOVERY_ID=rollback-2026.4-001
PRODUCTION_RECOVERY_CANDIDATE_RELEASE_ID=infra-deutschland-2026.4
PRODUCTION_RECOVERY_PREVIOUS_RELEASE_ID=infra-deutschland-2026.2
PRODUCTION_RECOVERY_PREVIOUS_WORLD_ID=00000000-0000-4000-8000-000000000014
PRODUCTION_RECOVERY_EVIDENCE_HOST_ROOT=./var/production-recovery/rollback-2026.4-001/evidence
PRODUCTION_RECOVERY_BACKUP_HOST_ROOT=./var/production-recovery/rollback-2026.4-001/material
PRODUCTION_RECOVERY_ODOO_FILESTORE_HOST_ROOT=./var/production-recovery/rollback-2026.4-001/odoo-filestore
PRODUCTION_RECOVERY_GAME_RESTORE_DATABASE=zugfolge_recovery_v1_2026_4_001
PRODUCTION_RECOVERY_ODOO_RESTORE_DATABASE=zugfolge_odoo_recovery_v1_2026_4_001
PRODUCTION_RECOVERY_GAME_VERIFY_DATABASE=zugfolge_restore_recovery_2026_4_001
# Kalter, unabhaengiger Vor-Schema-32/33-Drill. Game und Odoo liegen auf zwei
# separaten Recovery-PostgreSQL-Volumes; die Legacy-Game-/Odoo-/Keycloak-
# Runtimes bleiben portlos im internen schema29-recovery-Netz. Pristine und
# beschreibbare Runtime-Restores sowie beide Odoo-Filestores sind verschieden.
PRODUCTION_COLD_GAME_RESTORE_DATABASE=zugfolge_recovery_v1_verify_2026_4_001
PRODUCTION_COLD_ODOO_RESTORE_DATABASE=zugfolge_odoo_recovery_v1_cold_2026_4_001
PRODUCTION_SCHEMA29_GAME_RESTORE_DATABASE=zugfolge_recovery_v1_schema29_2026_4_001
PRODUCTION_SCHEMA29_ODOO_RESTORE_DATABASE=zugfolge_odoo_recovery_v1_schema29_2026_4_001
PRODUCTION_SCHEMA29_RUNTIME_GAME_RESTORE_DATABASE=zugfolge_recovery_v1_schema29_runtime_2026_4_001
PRODUCTION_SCHEMA29_RUNTIME_ODOO_RESTORE_DATABASE=zugfolge_odoo_recovery_v1_schema29_runtime_2026_4_001
PRODUCTION_RECOVERY_ACTION_TIMEOUT_MS=60000
# Vor dem Serverlauf mit `id -u odoo`/`id -g odoo` im exakt gepinnten
# Legacy-Odoo-Image ermitteln und an den Restore-Receipt binden.
PRODUCTION_RECOVERY_ODOO_RUNTIME_UID=100
PRODUCTION_RECOVERY_ODOO_RUNTIME_GID=101
MAP_RELEASE_PREFLIGHT_RUNTIME_WORLD_DEPLOYMENT_PATH=/evidence/alpha-world-deployment.json
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende, ODbL 1.0; Basemap-Aufbereitung Protomaps; weitere Bearbeitung durch Zugfolge
KEYCLOAK_PORT=8080
ODOO_PORT=8069
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
SIMULATION_INGEST_TOKEN=replace-with-32-random-characters
FLEET_INGEST_TOKEN=replace-with-another-32-random-characters
ALPHA_PSEUDONYM_SECRET=replace-with-a-pseudonym-secret
# Die Release- und Authority-Werte aus den zum Deployment erzeugten,
# signierten Artefakten uebernehmen. Der Server verweigert absichtlich den Start,
# solange Platzhalter nicht zum gepinnten M5-Bestand passen.
ZUGFOLGE_FLEET_AUTHORITY_RELEASE_PATH=/evidence/fleet-authority-releases.json
PLANNING_INFRASTRUCTURE_RELEASES_JSON=[]
PLANNING_AUTHORITY_ACCOUNT_IDS_JSON={}
ECONOMY_LEDGER_ACCOUNTS_JSON={}
INFRA_RELEASE_TRUSTED_KEYS_JSON={"zugfolge-alpha-2026":"-----BEGIN PUBLIC KEY-----\\nreplace\\n-----END PUBLIC KEY-----","zugfolge-alpha-2026.3":"-----BEGIN PUBLIC KEY-----\\nreplace\\n-----END PUBLIC KEY-----","zugfolge-map-deutschland-2026.4":"-----BEGIN PUBLIC KEY-----\\nreplace\\n-----END PUBLIC KEY-----"}
# Ein gemeinsamer kanonischer Public-Keyring, aber disjunkte Protokollrollen.
# Kein Weltdeployment-Schluessel darf Map-/Infra-Delivery autorisieren und umgekehrt.
RELEASE_TRUSTED_KEY_SCOPES_JSON={"alphaWorldDeployments":["zugfolge-alpha-2026","zugfolge-alpha-2026.3"],"mapInfraDeliveries":["zugfolge-map-deutschland-2026.4"]}
INFRA_ACTIVATION_SAFETY_REPORTS_JSON=[]
# Nur gemeinsam setzen: lokales RW-Staging, vollständiger Paketprüfer und eigener Odoo-Uploadschlüssel.
INFRA_PACKAGE_STAGING_ENABLED=false
INFRA_PACKAGE_STAGING_HOST_DIR=./var/infra-package-staging
INFRA_PACKAGE_STAGING_ROOT=/infra-package-staging
INFRA_PACKAGE_VERIFIER_MODULE=/app/tools/tiles/map-package.mjs
INFRA_UPLOAD_KEY_ID=odoo-infra-2026
INFRA_UPLOAD_SECRET=replace-with-at-least-32-random-characters
# Genau das Ed25519-signierte Public-Deployment.
ALPHA_WORLD_RELEASE_PATH=/evidence/alpha-world-deployment.json
# Nur fuer den einmaligen, exakt hashgebundenen V1->V2-Weltwechsel setzen;
# normale V2-Neustarts und leere Neuinstallationen lassen den Wert leer.
ALPHA_WORLD_V2_CUTOVER_AUTHORIZATION_JSON=
ODOO_WEBHOOK_TENANT_ID=zugfolge-production
ODOO_WEBHOOK_AUTHORIZED_ACTORS_JSON={"commerce-service":["entitlement.change","world.participation.change"],"odoo-alpha-admin":["admin.world_deploy","admin.alpha_invitation_create","admin.alpha_invitation_resend","admin.world_access_revoke","admin.disruption_policy_schedule"]}
ODOO_WEBHOOK_KEYS_JSON=[{"id":"alpha-2026","secret":"replace-odoo-webhook-secret","activeFrom":"2026-01-01T00:00:00.000Z"}]
ODOO_PROJECTION_URL=http://odoo:8069/zugfolge/projection
ODOO_RECONCILIATION_URL=http://odoo:8069/zugfolge/reconciliation/snapshot
ODOO_PROJECTION_KEY_ID=alpha-2026
ODOO_PROJECTION_SECRET=replace-odoo-projection-secret
PUBLIC_GAME_URL=http://localhost:4173
PHASE3_INVITATION_REFERENCE=replace-with-provisioned-invitation-reference
PHASE3_REQUESTER_LOGIN=replace-with-odoo-requester-login
PHASE3_APPROVER_LOGIN=replace-with-distinct-odoo-approver-login
PHASE3_PLAYER_ACCESS_TOKEN=replace-with-active-external-player-token
