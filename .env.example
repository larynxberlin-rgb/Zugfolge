# Zugfolge Alpha — kopieren nach .env; niemals echte Geheimnisse committen.
POSTGRES_USER=zugfolge
POSTGRES_PASSWORD=replace-game-db-password
POSTGRES_DB=zugfolge
ODOO_DB_PASSWORD=replace-odoo-db-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=alpha-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-keycloak-bootstrap-password
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-provisioner-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=provisioner
KEYCLOAK_REALM=zugfolge
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/zugfolge
KEYCLOAK_AUDIENCE=game-api
KEYCLOAK_INVITATION_REDIRECT_URI=http://localhost:4173/
GAME_WEB_URL=http://localhost:4173
GAME_WEB_PUBLIC_URL=http://localhost:4173
LIVEMAP_PUBLIC_URL=http://localhost:4174
GAME_API_PUBLIC_URL=/api
ALPHA_PUBLIC_WORLD_ID=00000000-0000-4000-8000-000000000014
OPERATIONS_CENTER_URL=http://localhost:4175
GAME_API_PORT=3000
GAME_WEB_PORT=4173
LIVEMAP_PORT=4174
OPERATIONS_CENTER_PORT=4175
STATIC_PORT=4179
# Einzige statische Kartenquelle. ID, Releasepfad und URLs stehen ausschließlich
# in ${MAP_RELEASE_DEPLOYMENT_HOST_ROOT}/active/map-release.env.
MAP_RELEASE_DEPLOYMENT_HOST_ROOT=./var/maps
# Stellt evidence.json, restore-proof.json und trusted-delivery-keys.json bereit.
MAP_RELEASE_PREFLIGHT_HOST_DIR=./var/map-release-preflight
# Tatsächlich auf einen vorbereiteten Leerpfad wiederhergestellter, vollständiger Buildcache.
MAP_RELEASE_RESTORE_HOST_DIR=./var/map-release-restore/infra-deutschland-2026.2
LIVEMAP_TRAIN_PROJECTION_PATH=/map-release/train-map-projection.sqlite
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende, ODbL 1.0; Basemap-Aufbereitung Protomaps; weitere Bearbeitung durch Zugfolge
KEYCLOAK_PORT=8080
ODOO_PORT=8069
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
SIMULATION_INGEST_TOKEN=replace-with-32-random-characters
FLEET_INGEST_TOKEN=replace-with-another-32-random-characters
ALPHA_PSEUDONYM_SECRET=replace-with-a-pseudonym-secret
# Die Release- und Authority-Werte aus den zum Deployment erzeugten,
# signierten Artefakten uebernehmen. Der Server verweigert absichtlich den Start,
# solange Platzhalter nicht zum gepinnten M5-Bestand passen.
ZUGFOLGE_FLEET_AUTHORITY_RELEASE_PATH=/evidence/fleet-authority-releases.json
PLANNING_INFRASTRUCTURE_RELEASES_JSON=[]
PLANNING_AUTHORITY_ACCOUNT_IDS_JSON={}
ECONOMY_LEDGER_ACCOUNTS_JSON={}
INFRA_RELEASE_TRUSTED_KEYS_JSON={"zugfolge-alpha-2026":"-----BEGIN PUBLIC KEY-----\\nreplace\\n-----END PUBLIC KEY-----"}
INFRA_ACTIVATION_SAFETY_REPORTS_JSON=[]
# Nur gemeinsam setzen: lokales RW-Staging, vollständiger Paketprüfer und eigener Odoo-Uploadschlüssel.
INFRA_PACKAGE_STAGING_ENABLED=false
INFRA_PACKAGE_STAGING_HOST_DIR=./var/infra-package-staging
INFRA_PACKAGE_STAGING_ROOT=/infra-package-staging
INFRA_PACKAGE_VERIFIER_MODULE=/app/tools/tiles/map-package.mjs
INFRA_UPLOAD_KEY_ID=odoo-infra-2026
INFRA_UPLOAD_SECRET=replace-with-at-least-32-random-characters
# Genau das Ed25519-signierte Public-Deployment. Tutorials entstehen ausschliesslich kurzlebig zur Laufzeit.
ALPHA_WORLD_RELEASE_PATHS_JSON=["/evidence/alpha-world-deployment.json"]
ODOO_WEBHOOK_TENANT_ID=zugfolge-production
ODOO_WEBHOOK_AUTHORIZED_ACTORS_JSON={"commerce-service":["entitlement.change","world.participation.change"],"odoo-alpha-admin":["admin.world_deploy","admin.alpha_invitation_create","admin.alpha_invitation_resend","admin.world_access_revoke"]}
ODOO_WEBHOOK_KEYS_JSON=[{"id":"alpha-2026","secret":"replace-odoo-webhook-secret","activeFrom":"2026-01-01T00:00:00.000Z"}]
ODOO_PROJECTION_URL=http://odoo:8069/zugfolge/projection
ODOO_RECONCILIATION_URL=http://odoo:8069/zugfolge/reconciliation/snapshot
ODOO_PROJECTION_KEY_ID=alpha-2026
ODOO_PROJECTION_SECRET=replace-odoo-projection-secret
PUBLIC_GAME_URL=http://localhost:4173
PHASE3_INVITATION_REFERENCE=replace-with-provisioned-invitation-reference
PHASE3_REQUESTER_LOGIN=replace-with-odoo-requester-login
PHASE3_APPROVER_LOGIN=replace-with-distinct-odoo-approver-login
PHASE3_PLAYER_ACCESS_TOKEN=replace-with-active-external-player-token
