<odoo>
    <record id="group_zugfolge_admin" model="res.groups"><field name="name">Zugfolge Administration</field></record>
  <record id="group_zugfolge_approver" model="res.groups"><field name="name">Zugfolge Freigabe</field><field name="implied_ids" eval="[(4, ref('zugfolge_admin.group_zugfolge_admin'))]"/></record>
  <record id="group_zugfolge_telemetry" model="res.groups"><field name="name">Zugfolge Telemetrie</field><field name="implied_ids" eval="[(4, ref('zugfolge_admin.group_zugfolge_admin'))]"/></record>
  <record id="group_zugfolge_infra_reviewer" model="res.groups"><field name="name">Zugfolge InfraRelease-Pruefung</field><field name="implied_ids" eval="[(4, ref('zugfolge_admin.group_zugfolge_admin'))]"/></record>
  <record id="rule_zugfolge_participation_portal_own" model="ir.rule">
    <field name="name">Portal sieht nur eigene Zugfolge-Weltteilnahmen</field>
    <field name="model_id" ref="model_zugfolge_world_participation"/>
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
  </record>
</odoo>
