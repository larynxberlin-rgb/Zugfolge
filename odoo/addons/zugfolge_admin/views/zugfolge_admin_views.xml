  <record id="view_zugfolge_admin_request_form" model="ir.ui.view"><field name="name">zugfolge.admin.request.form</field><field name="model">zugfolge.admin.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Einreichen" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Freigeben" groups="zugfolge_admin.group_zugfolge_approver" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Ablehnen" groups="zugfolge_admin.group_zugfolge_approver" invisible="state != 'submitted'"/><button name="action_dispatch" type="object" string="Signiert an Game senden" invisible="state != 'approved' or game_capability_state != 'available'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,dispatched,accepted,completed,failed"/></header><sheet><group><field name="world_projection_id"/><field name="action_type"/><field name="risk_class"/><field name="game_capability_state"/><field name="game_capability_detail"/><field name="requester_id"/><field name="approver_id"/><field name="reason" readonly="state != 'draft'"/><field name="effect_preview" widget="json"/><field name="release_hash" invisible="action_type != 'infra_release_adoption'" readonly="state != 'draft'"/><field name="requested_period_start" invisible="action_type != 'infra_release_adoption'" readonly="state != 'draft'"/><field name="target_reference" invisible="action_type not in ('world_access_revoke', 'abuse_sanction_activate')" readonly="state != 'draft'"/><field name="requested_at_s" invisible="action_type != 'world_close'" readonly="state != 'draft'"/><field name="manual_disruption_start" invisible="action_type != 'manual_disruption_create'" readonly="state != 'draft'"/><field name="manual_disruption_end" invisible="action_type != 'manual_disruption_create'" readonly="state != 'draft'"/><field name="manual_disruption_cause" invisible="action_type != 'manual_disruption_create'" readonly="state != 'draft'"/><field name="manual_disruption_resource_ids" widget="json" invisible="action_type != 'manual_disruption_create'" readonly="state != 'draft'"/><field name="manual_disruption_effect" widget="json" invisible="action_type != 'manual_disruption_create'" readonly="state != 'draft'"/><field name="correlation_id"/><field name="game_audit_event_id"/><field name="game_result" widget="json"/></group></sheet><chatter/></form></field></record>
  <record id="view_zugfolge_admin_request_world_deploy_form" model="ir.ui.view">
    <field name="name">zugfolge.admin.request.world.deploy.form</field>
    <field name="model">zugfolge.admin.request</field>
    <field name="inherit_id" ref="view_zugfolge_admin_request_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='world_projection_id']" position="attributes">
        <attribute name="invisible">action_type == 'world_deploy'</attribute>
        <attribute name="readonly">state != 'draft'</attribute>
      </xpath>
      <xpath expr="//field[@name='world_projection_id']" position="after">
        <field name="world_id" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="world_name" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="world_kind" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="ranking_status" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="schedule_period_weeks" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="world_epoch" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="starting_capital_mode" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="starting_capital_input" placeholder="10.000,00 &#8364;" invisible="action_type != 'world_deploy' or starting_capital_mode != 'finite'" readonly="state != 'draft'"/>
        <field name="starting_capital_amount_cents" invisible="action_type != 'world_deploy' or starting_capital_mode != 'finite'"/>
        <field name="starting_capital_preview" invisible="action_type != 'world_deploy'"/>
        <field name="signing_configuration" widget="json" invisible="action_type != 'world_deploy'"/>
        <field name="deployment_hash" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
        <field name="signed_world_deployment" widget="json" invisible="action_type != 'world_deploy'" readonly="state != 'draft'"/>
      </xpath>
      <xpath expr="//field[@name='action_type']" position="attributes">
        <attribute name="readonly">state != 'draft'</attribute>
      </xpath>
      <xpath expr="//field[@name='risk_class']" position="attributes">
        <attribute name="readonly">state != 'draft' or action_type == 'world_deploy'</attribute>
      </xpath>
    </field>
  </record>
