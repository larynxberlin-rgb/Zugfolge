  <record id="action_zugfolge_admin_request" model="ir.actions.act_window"><field name="name">Freigaben</field><field name="res_model">zugfolge.admin.request</field><field name="view_mode">list,form</field></record>
  <record id="action_zugfolge_feedback" model="ir.actions.act_window"><field name="name">Feedback</field><field name="res_model">zugfolge.feedback</field><field name="view_mode">list,form</field></record>
