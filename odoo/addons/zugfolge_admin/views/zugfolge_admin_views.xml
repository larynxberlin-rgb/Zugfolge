  <record id="view_move_form_zugfolge_entitlement" model="ir.ui.view"><field name="name">account.move.form.zugfolge.entitlement</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Zugfolge" invisible="move_type not in ('out_invoice', 'out_refund')"><group><field name="zugfolge_subject_reference"/><field name="zugfolge_correlation_id"/><field name="zugfolge_event_state"/></group></page></xpath></field></record>
