{
  "domains": [
    {
      "id": "determinism-core",
      "title": "Determinismus-Testharnisch (M0.2)",
      "status": "active",
      "paths": ["crates/zugfolge-determinism/**"],
      "rules": ["no-floats", "no-wallclock", "no-random", "no-unordered-iteration", "no-db-in-core"]
    },
    {
      "id": "simulation-core",
      "title": "Simulationskern — Sperrzeiten, Fahrdynamik, Zustand (M0.3, M3, M4)",
      "status": "active",
      "paths": ["crates/zugfolge-sim/**", "crates/zugfolge-conflict/**", "spikes/**"],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration",
        "no-db-in-core"
      ]
    },
    {
      "id": "path-allocation",
      "title": "Trassen-Planner und Vergabeverfahren (M3)",
      "status": "planned",
      "paths": ["crates/zugfolge-planner/**", "packages/path-allocation/**"],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration"
      ]
    },
    {
      "id": "dispatch",
      "title": "Live-Disposition und Regel-Engine des Betriebsprogramms (M4.4, M7)",
      "status": "planned",
      "paths": ["crates/zugfolge-rules/**", "packages/dispatch/**"],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration"
      ]
    },
    {
      "id": "demand",
      "title": "Nachfrage- und Zugwahlmodell (M10, M11)",
      "status": "planned",
      "paths": ["packages/demand/**", "crates/zugfolge-demand/**"],
      "rules": ["no-payment-tier", "no-wallclock", "no-random"]
    },
    {
      "id": "economy",
      "title": "Wirtschaft, Ledger, Verträge, Ausschreibungen (M2.4, M6)",
      "status": "active",
      "paths": ["packages/economy/**", "packages/tender/**", "apps/economy-service/**"],
      "rules": ["no-payment-tier", "no-wallclock", "no-random"]
    },
    {
      "id": "infra-pipeline",
      "title": "Infra-Release-Pipeline — der einzige Ort mit Gleitkommarechnung (M1)",
      "status": "active",
      "paths": ["crates/zugfolge-infra/**"],
      "rules": ["no-payment-tier", "no-wallclock", "no-random", "no-unordered-iteration"]
    },
    {
      "id": "world-isolation",
      "title": "Postgres-Zugriff der Game-Services, Wurzel der Weltisolation (M2.2)",
      "status": "active",
      "paths": ["packages/db/**"],
      "rules": ["world-id"]
    }
