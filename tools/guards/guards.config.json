{
  "domains": [
    {
      "id": "determinism-core",
      "title": "Determinismus-Testharnisch (M0.2)",
      "status": "active",
      "paths": ["crates/zugfolge-determinism/**"],
      "rules": ["no-floats", "no-wallclock", "no-random", "no-unordered-iteration", "no-db-in-core"]
    },
    {
      "id": "simulation-core",
      "title": "Simulationskern — Sperrzeiten, Zustand, Flotte und Störungen (M0.3, M3–M5, M8)",
      "status": "active",
      "paths": [
        "crates/zugfolge-sim/**",
        "crates/zugfolge-sim-runtime/**",
        "crates/zugfolge-runtime/**",
        "crates/zugfolge-runtime-napi/**",
        "crates/zugfolge-conflict/**",
        "crates/zugfolge-fleet/**",
        "crates/zugfolge-disruption/**",
        "crates/zugfolge-conductor/**",
        "packages/runtime-native/**",
        "spikes/**"
      ],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration",
        "no-db-in-core"
      ]
    },
    {
      "id": "path-allocation",
      "title": "Trassen-Planner und Vergabeverfahren (M3.4–M3.7)",
      "status": "active",
      "paths": [
        "crates/zugfolge-planner/**",
        "crates/zugfolge-planning-runtime/**",
        "crates/zugfolge-planning-runtime-napi/**",
        "packages/path-allocation/**",
        "packages/planning-projection/**",
        "packages/planning-runtime-native/**",
        "packages/planning-worker/**"
      ],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration"
      ]
    },
    {
      "id": "dispatch",
      "title": "Live-Disposition und Regel-Engine des Betriebsprogramms (M4.4, M7)",
      "status": "active",
      "paths": ["crates/zugfolge-rules/**", "packages/dispatch/**"],
      "rules": [
        "no-payment-tier",
        "no-floats",
        "no-wallclock",
        "no-random",
        "no-unordered-iteration"
      ]
    },
    {
      "id": "demand",
      "title": "Nachfrage- und Zugwahlmodell (M10, M11)",
      "status": "active",
      "paths": ["packages/demand/**", "crates/zugfolge-demand/**"],
      "rules": ["no-payment-tier", "no-floats", "no-wallclock", "no-random", "no-unordered-iteration", "no-db-in-core"]
    },
    {
      "id": "economy",
      "title": "Wirtschaft, Ledger, Verträge, Ausschreibungen und Kooperation (M2.4, M6, M12)",
      "status": "active",
      "paths": ["packages/economy/**", "packages/cooperation/**", "packages/tender/**", "apps/economy-service/**"],
      "rules": ["no-payment-tier", "no-wallclock", "no-random"]
    },
    {
      "id": "infra-pipeline",
      "title": "Infra-Release-Pipeline — der einzige Ort mit Gleitkommarechnung (M1)",
      "status": "active",
      "paths": ["crates/zugfolge-infra/**"],
      "rules": ["no-payment-tier", "no-wallclock", "no-random", "no-unordered-iteration"]
    },
    {
      "id": "world-isolation",
      "title": "Postgres-Zugriff der Game-Services, Wurzel der Weltisolation (M2.2)",
      "status": "active",
      "paths": ["packages/db/**"],
      "rules": ["world-id"]
    },
    {
      "id": "release-tools",
      "title": "Release-, Referenzkorpus-, Import- und Kartenwerkzeuge",
      "status": "active",
      "paths": [
        "tools/audits/**",
        "tools/reference-corpus/**",
        "tools/reference-model/**",
        "tools/region-import/**",
        "tools/demand-calibration/**",
        "tools/population-demand/**",
        "tools/tiles/**"
      ],
      "rules": []
    },
    {
      "id": "operations-tools",
      "title": "Betriebs-, Abnahme-, Last- und Governance-Werkzeuge",
      "status": "active",
      "paths": [
        "tools/alpha-ops/**",
        "tools/art-atlas/**",
        "tools/conductor-interior/**",
        "tools/guards/**",
        "tools/load/**",
        "tools/m7-acceptance/**",
        "tools/m7-e2e/**",
        "tools/ui-preview/**"
      ],
      "rules": []
    },
    {
      "id": "platform-services",
      "title": "Explizit zugeordnete Plattformdienste und Oberflächen",
      "status": "active",
      "paths": [
        "packages/alpha/**",
        "packages/browser-identity/**",
        "packages/commerce/**",
        "packages/conductor-art/**",
        "packages/design-system/**",
        "packages/disruption-provider/**",
        "packages/glossary/**",
        "packages/gtfs/**",
        "packages/health/**",
        "packages/identity/**",
        "packages/livemap/**",
        "packages/mailbox/**",
        "packages/operators/**",
        "packages/player-context/**",
        "packages/privacy/**",
        "apps/game-api/**",
        "apps/game-web/**",
        "apps/livemap/**",
        "apps/operations-center/**"
      ],
      "rules": []
    }
  ],
  "coverageExceptions": [],
  "brandTokenHashes": [],
  "allowedLicenses": [
    "0BSD",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "BlueOak-1.0.0",
    "CC0-1.0",
    "ISC",
    "MIT",
    "MIT-0",
    "Unicode-3.0",
    "Unlicense",
    "Zlib"
  ],
