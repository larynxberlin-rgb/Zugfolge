    {
      "package": "lightningcss*",
      "license": "MPL-2.0",
      "reason": "Entwicklungsabhängigkeit von Vite und damit von Vitest; unverändert eingebunden und nicht Teil des ausgelieferten Produkts. MPL-2.0 ist dateibezogenes Copyleft: Die Pflicht zur Offenlegung greift auf geänderte MPL-Dateien, nicht auf das umgebende Werk (Abschnitt 3.3, Larger Work). Damit vereinbar mit PolyForm Shield 1.0.0 (E16). Neu zu prüfen, sobald das Paket in eine Laufzeitabhängigkeit wandert oder wir es abwandeln."
    }
  ],
  "deniedLicenses": [
    "AGPL-1.0-only",
    "AGPL-1.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "SSPL-1.0"
  ],
  "ignore": [
    ".git",
    ".git/**",
    "**/node_modules",
    "**/node_modules/**",
    "**/target",
    "**/target/**",
    "**/dist",
    "**/dist/**",
    ".pnpm-store",
    ".pnpm-store/**",
    "var",
    "var/**",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "tools/guards/guards.config.json",
    "tools/guards/src/rules/**",
    "tools/guards/src/**/*.test.ts"
  ]
}
