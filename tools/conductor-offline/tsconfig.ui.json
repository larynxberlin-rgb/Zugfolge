{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@zugfolge/design-system": ["../../packages/design-system/src/index.ts"],
      "@zugfolge-offline/conductor-renderer": ["../../apps/livemap/src/conductor-renderer.ts"]
    }
  },
  "files": [
    "src/main.ts",
    "src/embedded.d.ts",
    "../../apps/livemap/node_modules/vite/client.d.ts",
    "../../packages/runtime-native/node_modules/@types/node/index.d.ts"
  ]
}
