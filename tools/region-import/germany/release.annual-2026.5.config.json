        "sourceId": "db-infrago-infrastructure-open-data",
        "entrypoint": "tools/region-import/germany/run-infrago-gpkg-adapter.mjs",
        "inputFormat": "GeoPackage",
        "geometryPolicy": "omit-blob-use-osm-single-track-geometry",
        "outputs": [
          "db-infrago-track-segments.jsonseq",
          "db-infrago-operating-places.jsonseq",
          "db-infrago-adapter-report.json"
        ]
      },
      "openStationNetex": {
        "sourceId": "openstation-enrichment",
        "entrypoint": "tools/region-import/germany/run-openstation-netex-adapter.mjs",
        "inputFormat": "NeTEx XML",
        "coordinatePolicy": "Direkter Stationspunkt oder exakter repraesentativer Punkt eines raeumlich belegten Kindobjekts; sonst unbekannt.",
        "outputs": [
          "openstation-stations.jsonseq",
          "stations.geojsonseq",
          "openstation-platform-points.geojsonseq",
          "openstation-adapter-report.json"
        ]
      },
      "copernicusDemGlo30": {
        "sourceId": "copernicus-dem-germany",
        "rightsSourceId": "dem-hoehenmodell",
        "entrypoint": "tools/region-import/germany/run-copernicus-dem.mjs",
        "inputFormat": "COP-DEM-GLO-30-DGED Cloud Optimized GeoTIFF, release 2021",
        "samplingPolicy": {
          "intervalMm": 30000,
          "minimumBaselineMm": 200000,
          "analysisWindowMm": 400000,
          "verticalAccuracyAssumptionMm": 4000,
          "maximumAbsoluteGradientPermille": 70,
          "maximumUncertaintyPermille": 50,
          "classAEligible": false
        },
        "outputs": [
          "copernicus-dem-track-enrichment.geojsonseq",
          "copernicus-dem-quality-report.json",
          "copernicus-dem-evidence-report.json"
        ]
      }
    },
    "postProcessors": {
      "mergeTrackGradient": {
        "entrypoint": "tools/region-import/germany/run-merge-track-enrichment.mjs",
        "baseLayer": "official-enriched-v2/tracks.geojsonseq",
        "enrichmentLayer": "copernicus-dem-track-enrichment.geojsonseq",
        "joinKey": "properties.feature_id",
        "geometryMustMatch": true,
        "existingPropertiesPreserved": true,
        "output": "official-enriched-dem/tracks.geojsonseq",
        "report": "official-enriched-dem/tracks.geojsonseq.report.json"
      }
    },
